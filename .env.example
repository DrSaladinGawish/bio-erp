# =============================================================================
# IncentiveHouse ERP v5.5 - Environment Variables
# Copy to .env and fill in secrets:
#   cp .env.example .env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Docker (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://bioerp:CHANGE_ME_DB_PASSWORD@db:5432/bio_erp
# Local dev without Docker (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./bio_erp.db

POSTGRES_DB=bio_erp
POSTGRES_USER=bioerp
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=generate-64-char-random-string-use-openssl-rand-hex-32
JWT_SECRET=another-64-char-random-string-for-jwt-tokens
IH_JWT_SECRET=              # Optional, defaults to JWT_SECRET
IH_ADMIN_PASSWORD=admin2026 # Login password for admin user
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ETA (Egyptian Tax Authority) ─────────────────────────────────────────────
ETA_BASE_URL=https://api.preprod.eta.gov.eg
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_PRIVATE_KEY_PATH=./keys/eta_private.pem
ETA_PUBLIC_KEY_PATH=./keys/eta_public.pem

# ── SMTP (Email) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@erp.example.com

# ── CBE (Central Bank of Egypt) ──────────────────────────────────────────────
CBE_API_URL=https://www.cbe.org.eg/api/currency-rates
CBE_API_KEY=

# ── Company Info ─────────────────────────────────────────────────────────────
COMPANY_TAX_ID=123456789
COMPANY_NAME=BIO-ERP Company
COMPANY_ACTIVITY_CODE=6201
DEFAULT_BRANCH_ID=1
DEFAULT_CURRENCY_ID=1
VAT_RATE_EG=0.14
VAT_RATE_UAE=0.05

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://localhost,https://erp.example.com

# ── Server ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info
ALLOWED_HOSTS=*
HOST=0.0.0.0
PORT=9001

# ── Nginx Ports ──────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── EventCore Bridge ─────────────────────────────────────────────────────────
EVENTCORE_BASE_URL=http://eventcore:8001
BIO_ERP_BRIDGE_TOKEN=CHANGE_ME_BRIDGE_TOKEN
