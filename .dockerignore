# =============================================================================
# IncentiveHouse ERP v5.5 - Docker ignore
# =============================================================================

# Git
.git
.gitignore
.gitattributes
.github

# Python
__pycache__
*.py[cod]
*$py.class
*.egg-info
.eggs
dist
build
*.egg
.pytest_cache
.ruff_cache

# Virtual env
.venv
venv
env

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / data (Docker volumes)
logs/*
data/*
uploads/*
!data/.gitkeep
!uploads/.gitkeep

# Environment (use Docker env vars instead)
.env
.env.local

# Docker (don't copy nested Docker context)
docker-compose*.yml
Dockerfile
.dockerignore

# Nginx / SSL (mounted as volumes)
nginx
ssl
scripts/gen-ssl*

# Docs
*.md
*.pdf
*.docx
*.zip
*.7z

# Reports / analysis
analysis_sandbox
reports
audit_report*.json
audit_report*.md
preflight_check.py
verify_*.py
fast_coverage.py
integration_test.py
smoke_test.log

# Backups
ihe_backups
migrations/versions/*.pyc
